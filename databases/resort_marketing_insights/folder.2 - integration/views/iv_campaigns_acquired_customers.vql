CREATE OR REPLACE VIEW iv_campaigns_acquired_customers FOLDER = '/2 - integration' AS
    SELECT bv_leads.campaign_id AS campaign_id,
           count(DISTINCT bv_leads.customer_id) AS acquired_customer_count
    FROM bv_leads
    WHERE status IN ('converted', 'closed')
    GROUP BY bv_leads.campaign_id CONTEXT ('formatted' = 'yes');

ALTER VIEW iv_campaigns_acquired_customers
 LAYOUT (bv_leads = [20, 20, 200, 200]);

